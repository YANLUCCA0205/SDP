# Copie para .env e ajuste. Nenhum segredo é necessário nesta versão (API sem autenticação, rede local).

# --- Modelo ---
# Troque para models/best.pt após o treinamento.
SDP_MODEL_PATH=models/yolo11n.pt
SDP_CONFIDENCE=0.25
SDP_IMGSZ=640
# cpu | 0 | cuda:0 (vazio = automático)
SDP_DEVICE=

# --- Fluxo de clientes (contagem de pessoas, modelo COCO) ---
SDP_PEOPLE_COUNTING_ENABLED=true
SDP_PERSON_MODEL_PATH=models/yolo11n.pt
SDP_PERSON_CLASS_ID=0
SDP_PERSON_CONFIDENCE=0.25
# Limites sobre a média de pessoas por captura durante o evento. VALORES PROVISÓRIOS: calibre com dados reais.
SDP_FLOW_LOW_MAX=1.0
SDP_FLOW_MEDIUM_MAX=3.0

# --- Regra de ruptura ---
SDP_MIN_OCCUPANCY=0.6
SDP_CONFIRMATIONS_REQUIRED=2
SDP_SHELF_CONFIG_PATH=config/shelves.yaml
SDP_DEFAULT_CAMERA_ID=cam-01

# --- Armazenamento ---
SDP_DATA_DIR=data
SDP_RECEIVED_DIR=received
SDP_RESULTS_DIR=results
# Vazio = sqlite em <SDP_DATA_DIR>/sdp.db
SDP_DATABASE_URL=
SDP_MAX_UPLOAD_MB=5
SDP_TIMEZONE=America/Sao_Paulo

SDP_LOG_LEVEL=INFO
